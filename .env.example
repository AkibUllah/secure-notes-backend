PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Frontend origin(s) allowed to call the API, comma separated (no trailing slash)
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops to trust for client IPs (1 behind nginx, 0 if exposed directly)
TRUST_PROXY=0
# Sync DB indexes with the schema.index() declarations on startup (drops undeclared indexes)
SYNC_INDEXES=true

# Used by `npm run seed` to create / reset the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
